# Klaviyo (public/site key only — never put a private key here)
VITE_KLAVIYO_PUBLIC_KEY=
VITE_KLAVIYO_LIST_ID=

# Google Tag Manager container ID (GTM-XXXXXXX)
# Put GA4 + Google Ads tags inside this container — do not add gtag IDs here.
VITE_GTM_ID=

# Shop — Stripe Payment Links (also hardcoded in src/lib/shop.ts)
VITE_STRIPE_BBE_EBOOK=https://buy.stripe.com/...
VITE_STRIPE_BBE_ANKLE=https://buy.stripe.com/...
VITE_STRIPE_BBE_BUNDLE=https://buy.stripe.com/...

# ── Fulfillment API (server only — set these on Railway) ─────────────
SITE_URL=https://activex.fit
PORT=8787

# Stripe secret key (sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (whsec_...) from
# Developers → Webhooks → endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=

# Optional but recommended: Price IDs (price_...) for reliable product matching
STRIPE_PRICE_EBOOK=
STRIPE_PRICE_ANKLE=
STRIPE_PRICE_BUNDLE=

# Optional: Payment Link IDs (plink_...) as another match strategy
STRIPE_PLINK_EBOOK=
STRIPE_PLINK_ANKLE=
STRIPE_PLINK_BUNDLE=

# HMAC secret for signed eBook download links (any long random string)
DOWNLOAD_SECRET=

# Google Workspace SMTP (use an App Password, not your normal login password)
# Google Admin / Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@activex.fit
SMTP_PASS=
EMAIL_FROM=activeX Shop <info@activex.fit>
SHIP_NOTIFY_EMAIL=info@activex.fit

# eBook file: either place private/bbe-ebook.pdf in the deploy,
# or set a private URL only the server can fetch:
# EBOOK_FILE_URL=https://...
